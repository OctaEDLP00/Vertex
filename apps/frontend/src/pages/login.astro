---
import '../styles/globals.css'
---

<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width" name="viewport">
    <title>Sign in to Vertex</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <style>
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
    </style>
  </head>
  <body class="bg-canvas-base text-text-primary min-h-screen flex flex-col font-mono antialiased selection:bg-primary selection:text-canvas-base h-screen">
    <!-- Full Width Terminal Header -->
    <div class="bg-surface-variant px-6 py-2 flex items-center justify-between border-b border-border-subtle w-full">
      <div class="flex space-x-2">
        <div class="w-3 h-3 rounded-full bg-[#f85149]"></div>
        <div class="w-3 h-3 rounded-full bg-[#ffb68b]"></div>
        <div class="w-3 h-3 rounded-full bg-[#3fb950]"></div>
      </div>
      <div class="text-sm text-text-secondary">vertex@auth:~</div>
      <div class="w-12"></div> <!-- spacer for center alignment -->
    </div>
    <!-- Main Content Area -->
    <div class="p-8 grow overflow-y-auto flex-1">
      <div class="max-w-4xl space-y-6">
        <!-- Welcome / Help Block -->
        <div>
          <div class="mb-2">
            <span class="text-text-secondary">$</span>
            <span class="text-text-primary">vertex --help</span>
          </div>
          <div class="text-text-secondary mb-4">
            Available commands:
          </div>
          <div class="grid grid-cols-[150px_1fr] gap-4 mb-8">
            <a class="text-primary hover:underline decoration-primary underline-offset-4" href="#">./login.sh</a>
            <span class="text-text-secondary">- Sign in to your account</span>
            <a class="text-primary hover:underline decoration-primary underline-offset-4" href="#">./register.sh</a>
            <span class="text-text-secondary">- Create a new account</span>
            <a class="text-primary hover:underline decoration-primary underline-offset-4" href="#">./login-pat.sh</a>
            <span class="text-text-secondary">- Login with Personal Access Token</span>
          </div>
        </div>
        <!-- Login Form Block (Simulated Execution) -->
        <div>
          <div class="mb-4">
            <span class="text-text-secondary">$</spa>
            <span class="text-text-primary">./login.sh</span>
          </div>
          <form action="#" class="space-y-6 pl-4 border-l-2 border-border-subtle" method="POST">
            <!-- Username Input -->
            <div class="space-y-2">
              <label class="block text-text-secondary" for="username">
                <span class="text-primary">&gt;</span>
                Enter username or email:
              </label>
              <input
                id="username"
                name="username"
                placeholder="OctaEDLP00"
                required=""
                type="text"
                class="w-full max-w-md bg-transparent border-0 border-b border-border-subtle px-0 py-1 text-primary focus:outline-none focus:border-primary focus:ring-0 transition-none placeholder-text-secondary/50 font-mono"
              >
            </div>
            <!-- Password Input -->
            <div class="space-y-2">
              <div class="flex items-center justify-between max-w-md">
                <label class="block text-text-secondary" for="password">
                  <span class="text-primary">&gt;</span>
                  Enter password:
                </label>
              </div>
              <input
                id="password"
                name="password"
                placeholder="******"
                required=""
                type="password"
                class="w-full max-w-md bg-transparent border-0 border-b border-border-subtle px-0 py-1 text-primary focus:outline-none focus:border-primary focus:ring-0 transition-none placeholder-text-secondary/50 font-mono"
              >
            </div>
            <!-- Primary Action Button -->
            <div class="pt-4 max-w-md">
              <button class="w-full bg-transparent border border-primary text-primary py-2 hover:bg-primary hover:text-canvas-base transition-colors duration-0 font-mono" type="submit">
                [ Execute Login ]
              </button>
              <div class="mt-2 text-right">
                <a class="text-xs text-text-secondary hover:text-primary hover:underline" href="#">
                  --help forgot-password
                </a>
              </div>
            </div>
          </form>
        </div>
        <!-- Prompt -->
        <div class="pt-8 flex items-center">
          <span class="text-text-secondary mr-2">[root@vertex ~]#</span>
          <span class="w-2.5 h-5 bg-text-primary animate-pulse inline-block"></span>
        </div>
      </div>
    </div>
  </body>
</html>
