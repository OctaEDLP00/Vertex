{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["jsx-a11y", "jsdoc", "node", "react"],
  "rules": {
    "react/jsx-no-duplicate-props": "error",
    "react/react-in-jsx-scope": "off", // Astro y React moderno no lo necesitan
    "jsx-a11y/alt-text": "error" // Accesibilidad estricta
  }
}
